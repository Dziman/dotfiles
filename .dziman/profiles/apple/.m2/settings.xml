<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.1.0 http://maven.apache.org/xsd/settings-1.1.0.xsd">
  <servers>
    <server>
      <username>${env.ACS_ARTIFACTORY_USR}</username>
      <password>${env.ACS_ARTIFACTORY_PSW}</password>
      <id>acs-release</id>
    </server>
    <server>
      <username>${env.ACS_ARTIFACTORY_USR}</username>
      <password>${env.ACS_ARTIFACTORY_PSW}</password>
      <id>acs-snapshot</id>
    </server>
  </servers>
  <profiles>
    <profile>
      <id>artifactory</id>
      <repositories>
        <repository>
          <id>acs-release</id>
          <url>${env.ACS_ARTIFACTORY_RELEASE_URL}</url>
          <releases>
            <enabled>true</enabled>
          </releases>
          <snapshots>
            <enabled>false</enabled>
          </snapshots>
        </repository>
        <repository>
          <id>acs-snapshot</id>
          <url>${env.ACS_ARTIFACTORY_SNAPSHOT_URL}</url>
          <releases>
            <enabled>false</enabled>
          </releases>
          <snapshots>
            <enabled>true</enabled>
          </snapshots>
        </repository>
      </repositories>
      <pluginRepositories>
        <pluginRepository>
          <id>acs-release</id>
          <url>${env.ACS_ARTIFACTORY_RELEASE_URL}</url>
          <releases>
            <enabled>true</enabled>
          </releases>
          <snapshots>
            <enabled>false</enabled>
          </snapshots>
        </pluginRepository>
        <pluginRepository>
          <id>acs-snapshot</id>
          <url>${env.ACS_ARTIFACTORY_SNAPSHOT_URL}</url>
          <releases>
            <enabled>false</enabled>
          </releases>
          <snapshots>
            <enabled>true</enabled>
          </snapshots>
        </pluginRepository>
      </pluginRepositories>
    </profile>
  </profiles>
  <activeProfiles>
    <activeProfile>artifactory</activeProfile>
  </activeProfiles>
</settings>
