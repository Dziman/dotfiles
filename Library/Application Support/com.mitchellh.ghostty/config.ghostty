font-family = ""
#font-family = "Terminess Nerd Font Mono"
font-family = "Hasklug Nerd Font Mono"
font-family = "IosevkaTerm Nerd Font Mono"
font-family = "SauceCodePro Nerd Font"
font-family = "CaskaydiaMono Nerd Font Mono"
font-family = "Cascadia Code NF"
font-family = "ShureTechMono Nerd Font Mono"
font-size=18
font-feature = +liga
# Config generated by Ghostty Config

quit-after-last-window-closed = true
shell-integration = zsh
clipboard-read = allow
window-show-tab-bar = always

#theme = Desert
theme = Zenburn

#theme = Zenburned
#background = #404040
#foreground = #f0e4cf
#selection-background = #746956
#selection-foreground = #f0e4cf
#cursor-color = #f3eadb
#cursor-text = #404040
#palette = 0=#404040
#palette = 1=#e3716e
#palette = 2=#819b69
#palette = 3=#b77e64
#palette = 4=#6099c0
#palette = 5=#b279a7
#palette = 6=#66a5ad
#palette = 7=#f0e4cf
#palette = 8=#6f6768
#palette = 9=#ec8685
#palette = 10=#8bae68
#palette = 11=#d68c67
#palette = 12=#61abda
#palette = 13=#cf86c1
#palette = 14=#65b8c1
#palette = 15=#c0ab86
#macos-option-as-alt = left

#unfocused-window-opacity = 0.8  # Adjust between 0.0 (fully transparent) and 1.0 (no dimming)
#unfocused-window-fill = true

cursor-style = block
shell-integration-features = no-cursor