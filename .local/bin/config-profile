#!/bin/sh
# Select the dotfiles profile of this machine and link its files into $HOME.
#
#   config-profile <name>             activate ~/.dziman/profiles/<name>
#   config-profile --show             print the active profile name
#   config-profile status             state of the active profile's links
#   config-profile adopt <path>...    move a file or directory into the active profile and link it
#   config-profile unadopt <path>...  move it back into $HOME (still tracked, at that path)
#   config-profile rollout <ref> <name>  first switch of a machine: back up files in the way,
#                                     switch the dotfiles branch to <ref>, activate <name>
#   config-profile --help             how profiles work and how to make a file profile-specific
#
# ~/.dziman/profile -> profiles/<name> is the only per-machine state; shared config
# reads profile parts through it. Profiles mirror the $HOME layout. The paths in
# profiles/<name>/links (one $HOME-relative file or directory per line) are
# symlinked into $HOME on activation, one link per file so untracked neighbours
# stay untouched; the links point through ~/.dziman/profile, never at a profile
# by name, and are listed in the repo's info/exclude so `config status` stays clean.
set -eu

profiles_dir="$HOME/.dziman/profiles"
link="$HOME/.dziman/profile"
git_dir=${DZIMAN_DOTFILES:-$HOME/.dziman-dotfiles}
exclude_begin='# config-profile links (managed, do not edit)'
exclude_end='# end config-profile links'
backup_dir=            # set by rollout: files in the way move here instead of blocking

usage() {
  echo "usage: config-profile <name> | --show | status | adopt <path>... | unadopt <path>... | rollout <remote>/<branch> <name> | --help" >&2
  echo "profiles: $(ls "$profiles_dir" | tr '\n' ' ')" >&2
  exit 2
}

help() {
  cat <<EOF
config-profile: per-machine profile of the dotfiles

  config-profile <name>             activate profile <name>
  config-profile --show             print the active profile name
  config-profile status             each link of the active profile: ok / broken / shadowed / missing,
                                    plus untracked files inside the profile directory
  config-profile adopt <path>...    make a file or directory profile-specific (see below)
  config-profile unadopt <path>...  undo that: back into \$HOME, tracked there
  config-profile rollout <remote>/<branch> <name>
                                    first switch of a machine (see below)
  config-profile --help, -h         this text

Profiles:         ${profiles_dir#"$HOME"/}/<name>/   ($(ls "$profiles_dir" | tr '\n' ' '))
Active profile:   $(active | grep . || echo "none set")
Switch:           config-profile <name>; then exec zsh. Shared config reads the profile
                  through the symlink ~/.dziman/profile -> profiles/<name>, the only
                  per-machine state. DZIMAN_PROFILE holds the name in zsh.

A profile directory mirrors \$HOME: the profile's part of ~/.gitconfig is
profiles/<name>/.gitconfig. Two kinds of file live there:

  part        A fragment a shared file includes through ~/.dziman/profile/...:
              zsh     profiles/<name>/.zsh-dziman/*.zsh          (sourced after the shared ones)
              emacs   profiles/<name>/.emacs-dziman/configs/*.el (loaded last)
              git     profiles/<name>/.gitconfig                 ([include] in ~/.gitconfig)
              tmux    profiles/<name>/.tmux.conf                 (source-file -q)
              omp     profiles/<name>/.omp/agent/config.yml      (--config overlay)
              claude  profiles/<name>/.claude/CLAUDE.md          (@import at the end)
              Put a per-machine difference here when the shared file can include it;
              an absent part is a no-op. No registration needed.

  whole file  A file that must exist at its \$HOME path (~/.ssh/config, ~/.claude/settings.json,
              ~/Local/AS/...). It lives at profiles/<name>/<path> and is listed in
              profiles/<name>/links (one \$HOME-relative file or directory per line). On
              activation each file gets a symlink in \$HOME, through ~/.dziman/profile, one
              link per file so untracked neighbours stay. The link paths go into the bare
              repo's info/exclude, so \`config status\` stays clean.

Make a file profile-specific:
  config-profile adopt ~/.foo/bar.conf      moves it to profiles/<active>/.foo/bar.conf,
                                            adds the line to links, makes the link, stages it
  A file tracked for every machine is moved only after a y/N prompt: the other profiles lose
  it. When only part of it differs, keep it shared and write the difference as a part instead.
  Directories adopt whole; a file the directory gains later in \$HOME needs its own adopt.
  Then: config commit.

Undo:             config-profile unadopt ~/.foo/bar.conf   (refuses to overwrite a real file)

Troubleshooting:  "a file is in the way: ~/x" at activation: a real file sits where a link
                  should be. Diff it against ~/.dziman/profile/x, keep the right one there,
                  remove the \$HOME copy, run config-profile <name> again.
                  "shadowed" in status: a tool replaced the link by a real file (same recipe).
                  "broken": the profile lost the file; "missing": run config-profile <name>.

Rollout:          first switch of a machine, run from \$HOME after \`config fetch <remote> <branch>\`:
                    config-profile rollout <remote>/<branch> <name>
                  Refuses while tracked files are modified. Untracked files the branch
                  tracks, and real files sitting at link paths, move to
                  ~/.dziman/rollout-backup/<time>/<path> (diff them afterwards); then the
                  branch is switched, the profile activated, ~/.zcompdump and emptied
                  directories removed. Before the script exists on the machine:
                    config show <remote>/<branch>:.local/bin/config-profile > /tmp/config-profile
                    sh /tmp/config-profile rollout <remote>/<branch> <name>

More:             ~/.dziman/docs/profiles.md
EOF
}

die() { echo "config-profile: $*" >&2; exit 1; }

cfg() { git -C "$HOME" --git-dir="$git_dir" --work-tree="$HOME" "$@"; }

has_repo() { [ -d "$git_dir" ]; }

active() { basename "$(readlink "$link" 2>/dev/null || true)"; }

require_active() {
  name=$(active)
  [ -n "$name" ] || die "no profile set"
}

manifest() { echo "$profiles_dir/$1/links"; }

# Manifest lines without comments, blanks and trailing slashes.
manifest_entries() {
  [ -r "$(manifest "$1")" ] || return 0
  grep -v '^[[:space:]]*\(#\|$\)' "$(manifest "$1")" | sed 's|/*$||' || true
}

is_listed() { # profile path
  grep -qxF -- "$2" "$(manifest "$1")" 2>/dev/null
}

# Every file below $profiles_dir/<profile>/<entry>, as $HOME-relative paths; a missing
# entry is passed through so its link can still be reported or removed.
files_of_entry() { # profile entry
  src="$profiles_dir/$1/$2"
  if [ -d "$src" ] && [ ! -L "$src" ]; then
    find "$src" \( -type f -o -type l \) | while read -r f; do printf '%s\n' "${f#"$profiles_dir/$1/"}"; done
  else
    printf '%s\n' "$2"
  fi
}

profile_files() { # profile
  manifest_entries "$1" | while read -r entry; do files_of_entry "$1" "$entry"; done
}

# Relative target from $HOME/<path> to ~/.dziman/profile/<path>.
link_target() {
  up=$(printf '%s' "$1" | awk -F/ '{ for (i = 1; i < NF; i++) printf "../" }')
  printf '%s\n' "${up}.dziman/profile/$1"
}

is_profile_link() {
  [ -L "$1" ] || return 1
  case $(readlink "$1") in .dziman/profile/*|*/.dziman/profile/*) return 0 ;; esac
  return 1
}

remove_links() { # $HOME-relative paths on stdin
  while read -r p; do
    if is_profile_link "$HOME/$p"; then rm "$HOME/$p"; fi
  done
}

# Links every path on stdin; a real file in the way is reported and kept. Returns 1 if any was.
make_links() {
  skipped=0
  while read -r p; do
    dst="$HOME/$p"
    if [ ! -e "$link/$p" ] && [ ! -L "$link/$p" ]; then
      echo "config-profile: not linked, no such file in the profile: $p" >&2
      skipped=1
      continue
    fi
    if [ -e "$dst" ] || [ -L "$dst" ]; then
      if ! is_profile_link "$dst"; then
        if [ -n "$backup_dir" ]; then
          back_up "$p"
        else
          echo "config-profile: not linked, a file is in the way: ~/$p" >&2
          skipped=1
          continue
        fi
      fi
    fi
    mkdir -p "$(dirname "$dst")"
    ln -sfn "$(link_target "$p")" "$dst"
  done
  [ $skipped -eq 0 ]
}

exclude_file() { printf '%s\n' "$git_dir/info/exclude"; }

# Link paths recorded in info/exclude by the last activation ($HOME-relative).
recorded_links() {
  has_repo && [ -f "$(exclude_file)" ] || return 0
  awk -v b="$exclude_begin" -v e="$exclude_end" '$0 == e { exit } on { print } $0 == b { on = 1 }' "$(exclude_file)" \
    | sed 's|^/||; s|\\\(.\)|\1|g'
}

# Moves $HOME/<path> under $backup_dir, keeping the relative path.
back_up() { # path
  mkdir -p "$backup_dir/$(dirname "$1")"
  mv "$HOME/$1" "$backup_dir/$1"
  printf '%s\n' "$1" >> "$backup_dir/.list"
}

# Rewrites the managed block of info/exclude with the profile's link paths, as
# literal gitignore patterns anchored to the root. Lines outside the block stay.
write_exclude() { # profile
  has_repo || return 0
  mkdir -p "$git_dir/info"
  [ -f "$(exclude_file)" ] || : > "$(exclude_file)"
  tmp=$(mktemp)
  {
    awk -v b="$exclude_begin" -v e="$exclude_end" '$0 == b { skip = 1 } !skip { print } $0 == e { skip = 0 }' "$(exclude_file)"
    echo "$exclude_begin"
    profile_files "$1" | sed 's|[][*?\\!#]|\\&|g; s|^|/|'
    echo "$exclude_end"
  } > "$tmp"
  cat "$tmp" > "$(exclude_file)"
  rm -f "$tmp"
}

activate() {
  name=$1
  case $name in
    ''|*/*|.*) echo "config-profile: invalid profile name: '$name'" >&2; usage ;;
  esac
  [ -d "$profiles_dir/$name" ] || { echo "config-profile: no such profile: $name" >&2; usage; }

  recorded_links | remove_links
  old=$(active)
  if [ -n "$old" ] && [ -d "$profiles_dir/$old" ]; then profile_files "$old" | remove_links; fi
  ln -sfn "profiles/$name" "$link"
  write_exclude "$name"
  if profile_files "$name" | make_links; then
    echo "profile: $name"
  else
    echo "profile: $name (some links skipped)" >&2
    exit 1
  fi
}

status() {
  require_active
  echo "profile: $name"
  profile_files "$name" | while read -r p; do
    dst="$HOME/$p"
    if is_profile_link "$dst"; then
      if [ -e "$dst" ]; then state=ok; else state=broken; fi
    elif [ -e "$dst" ] || [ -L "$dst" ]; then
      state=shadowed
    else
      state=missing
    fi
    printf '%-9s ~/%s\n' "$state" "$p"
  done
  has_repo || return 0
  cfg ls-files --others --exclude-standard -- ".dziman/profiles/$name" | sed 's/^/untracked /'
}

# $HOME-relative path of an existing file or directory, or failure when outside $HOME.
home_relative() {
  p=${1%/}
  case $(basename "$p") in .|..) return 1 ;; esac
  abs=$(cd "$(dirname "$p")" 2>/dev/null && pwd)/$(basename "$p")
  case $abs in
    "$HOME"/.dziman/profile/*|"$HOME"/.dziman/profiles/*) return 1 ;;
    "$HOME"/*) echo "${abs#"$HOME"/}" ;;
    *) return 1 ;;
  esac
}

# Fails when a directory on the way to profiles/<profile>/<path> is a symlink (main's
# .claude points at ai's): moving through it would change another profile.
require_direct() { # profile path
  dir="$profiles_dir/$1"
  rest=$2
  while [ "$rest" != "${rest#*/}" ]; do
    dir="$dir/${rest%%/*}"
    rest=${rest#*/}
    [ -L "$dir" ] && die "$2 lies behind a symlink in profile $1 (${dir#"$profiles_dir/"}); adopt it in that profile"
  done
  return 0
}

# A tracked file is shared by every machine; moving it is a deliberate choice, so ask.
confirm_move() { # path
  cat >&2 <<EOF
config-profile: ~/$1 is tracked for every machine. Adopting moves it into profile
$name; the other profiles lose it at their next switch. If only part of it
differs per machine, keep it shared and put the difference in a profile part
that the shared file includes.
EOF
  printf 'move ~/%s into profile %s? [y/N] ' "$1" "$name" >&2
  read -r answer || answer=
  case $answer in y|Y|yes) return 0 ;; *) return 1 ;; esac
}

manifest_add() { # profile path
  is_listed "$1" "$2" || printf '%s\n' "$2" >> "$(manifest "$1")"
  if has_repo; then cfg add -- ".dziman/profiles/$1/links"; fi
}

manifest_remove() { # profile path
  tmp=$(mktemp)
  grep -vxF -- "$2" "$(manifest "$1")" > "$tmp" || true
  mv "$tmp" "$(manifest "$1")"
  if has_repo; then cfg add -- ".dziman/profiles/$1/links"; fi
}

adopt() {
  require_active
  for p; do
    rel=$(home_relative "$p") || die "not a file under \$HOME: $p"
    src="$HOME/$rel"
    dst="$profiles_dir/$name/$rel"
    [ -L "$src" ] && die "already a link: ~/$rel"
    [ -e "$src" ] || die "no such file: ~/$rel"
    [ -e "$dst" ] && die "already in profile $name: $rel"
    require_direct "$name" "$rel"
    if has_repo && cfg check-ignore -q -- ".dziman/profiles/$name/$rel"; then die "ignored by .gitignore: $rel"; fi
    mkdir -p "$(dirname "$dst")"
    if has_repo && cfg ls-files --error-unmatch -- "$rel" >/dev/null 2>&1; then
      confirm_move "$rel" || die "not adopted: ~/$rel"
      cfg mv -- "$rel" ".dziman/profiles/$name/$rel"
    else
      mv "$src" "$dst"
      if has_repo; then cfg add -- ".dziman/profiles/$name/$rel"; fi
    fi
    manifest_add "$name" "$rel"
    files_of_entry "$name" "$rel" | make_links
    write_exclude "$name"
    echo "adopted: ~/$rel"
  done
}

unadopt() {
  require_active
  for p; do
    rel=$(home_relative "$p") || die "not a file under \$HOME: $p"
    is_listed "$name" "$rel" || die "not listed in profiles/$name/links: $rel"
    src="$profiles_dir/$name/$rel"
    [ -e "$src" ] || [ -L "$src" ] || die "not in profile $name: $rel"
    require_direct "$name" "$rel"
    files_of_entry "$name" "$rel" | while read -r f; do
      if [ -e "$HOME/$f" ] || [ -L "$HOME/$f" ]; then
        is_profile_link "$HOME/$f" || die "a file is in the way, nothing moved: ~/$f"
      fi
    done
    tracked=0
    if has_repo && cfg ls-files --error-unmatch -- ".dziman/profiles/$name/$rel" >/dev/null 2>&1; then tracked=1; fi
    files_of_entry "$name" "$rel" | remove_links
    if [ $tracked -eq 1 ]; then cfg rm -r -q --cached -- ".dziman/profiles/$name/$rel"; fi
    files_of_entry "$name" "$rel" | while read -r f; do
      mkdir -p "$(dirname "$HOME/$f")"
      mv "$profiles_dir/$name/$f" "$HOME/$f"
    done
    if [ -d "$src" ]; then find "$src" -depth -type d | while read -r d; do rmdir "$d"; done; fi
    (cd "$profiles_dir/$name" && rmdir -p "$(dirname "$rel")" 2>/dev/null || true)
    manifest_remove "$name" "$rel"
    write_exclude "$name"
    if [ $tracked -eq 1 ]; then cfg add -- "$rel"; fi
    echo "unadopted: ~/$rel"
  done
}

# Removes a directory and its parents while they are empty, never $HOME itself.
rmdir_empty_up() { # $HOME-relative directory
  d="$HOME/$1"
  while [ "$d" != "$HOME" ] && [ -d "$d" ] && rmdir "$d" 2>/dev/null; do d=$(dirname "$d"); done
  return 0
}

rollout() { # ref profile
  ref=$1
  name=$2
  [ "$(pwd -P)" = "$(cd "$HOME" && pwd -P)" ] || { echo "config-profile rollout: run it from \$HOME (cd ~)" >&2; exit 2; }
  case $name in ''|*/*|.*) echo "config-profile: invalid profile name: '$name'" >&2; usage ;; esac
  has_repo || die "no dotfiles repo at $git_dir"
  cfg rev-parse --verify -q "$ref^{commit}" >/dev/null || die "unknown ref: $ref (config fetch <remote> <branch> first)"
  cfg ls-tree -d "$ref" -- ".dziman/profiles/$name" | grep -q . || die "no profile $name on $ref"
  modified=$( { cfg diff --name-only; cfg diff --cached --name-only; } | sort -u)
  [ -z "$modified" ] || die "commit or discard local edits first:
$modified"

  backup_dir="$HOME/.dziman/rollout-backup/$(date +%Y%m%d-%H%M%S)"
  old_head=$(cfg rev-parse HEAD)
  cfg ls-tree -r --full-tree --name-only "$ref" | while read -r p; do
    { [ -e "$HOME/$p" ] || [ -L "$HOME/$p" ]; } || continue
    cfg ls-files --error-unmatch -- ":/$p" >/dev/null 2>&1 && continue
    back_up "$p"
  done

  branch=${ref##*/}
  if cfg show-ref --verify -q "refs/heads/$branch"; then
    cfg switch -q "$branch"
    cfg merge -q --ff-only "$ref"
  else
    cfg switch -q -c "$branch" "$ref"
    cfg branch -q --set-upstream-to="$ref" 2>/dev/null || true
  fi

  activate "$name"
  rm -f "$HOME"/.zcompdump*
  cfg diff --name-only --diff-filter=D "$old_head" HEAD | while read -r p; do rmdir_empty_up "$(dirname "$p")"; done

  if [ -f "$backup_dir/.list" ]; then
    echo "backed up, diff each against the new copy:"
    while read -r p; do echo "  diff ${backup_dir#"$HOME"/}/$p $p"; done < "$backup_dir/.list"
  fi
}

case ${1-} in
  --help|-h|help) help ;;
  rollout) [ $# -eq 3 ] || usage; rollout "$2" "$3" ;;
  --show) [ $# -eq 1 ] || usage; require_active; echo "$name" ;;
  status) [ $# -eq 1 ] || usage; status ;;
  adopt) [ $# -ge 2 ] || usage; shift; adopt "$@" ;;
  unadopt) [ $# -ge 2 ] || usage; shift; unadopt "$@" ;;
  '') usage ;;
  *) [ $# -eq 1 ] || usage; activate "$1" ;;
esac
